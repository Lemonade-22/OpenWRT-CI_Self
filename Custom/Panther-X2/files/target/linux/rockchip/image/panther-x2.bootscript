# Panther X2 UART2; explicit so the RK3566 console does not depend on $soc.
part uuid ${devtype} ${devnum}:2 uuid
setenv bootargs "coherent_pool=2M console=tty1 console=ttyS2,1500000 earlycon=uart8250,mmio32,0xfe660000 root=PARTUUID=${uuid} rw rootwait"
load ${devtype} ${devnum}:1 ${kernel_addr_r} kernel.img
bootm ${kernel_addr_r}
