# ============================================================
# 已停用 / DEPRECATED —— 2026-11-06
# ============================================================
# 这台 AP8220 的 NAND 已经改成单分区布局：
#   MIBIB 里 NAND 只有一个 rootfs 分区，覆盖整片 1 GiB；
#   内核 DTB 用 qcom,smem-part；NAND 上只有一个 UBI 容器。
#
# 本工作流产出的固件是 QWRT(1000 MiB) + ubi_kernel(24 MiB) 双分区版本，
# 在当前布局下刷不进去，也不要再刷。
#
# 替代品：.github/workflows/AP8220-1G-Single.yml
# Actions 里显示为「AP8220-1G-Single rootfs」。
#
# 文件名后缀已改成 .disabled：GitHub 只处理 workflows 目录下的
# *.yml / *.yaml，所以不会再出现在 Actions 列表里。
# 保留本文件仅作历史参考，需要时把后缀改回 .yml 即可恢复。
# ============================================================
# SPDX-License-Identifier: MIT
# Copyright (C) 2026 VIKINGYFY

# AP8220 1 GiB NAND（双分区旧方案）
# PPE uses VIKINGYFY/immortalwrt owrt; NSS uses main.
name: AP8220-1G（已停用，见 AP8220-1G-Single rootfs）
run-name: ${{ inputs.FIRMWARE || '编译PPE固件' }} · ${{ inputs.TEST && '仅输出配置' || '完整编译' }}

on:
  #手动编译
  workflow_dispatch:
    inputs:
      FIRMWARE:
        description: '固件类型'
        type: choice
        required: true
        default: '编译PPE固件'
        options:
          - '编译PPE固件'
          - '编译NSS固件'
      PACKAGE:
        description: '手动调整插件包，多个请用换行符分隔。'
        required: false
        type: string
      TEST:
        description: '仅输出配置文件，不编译固件。'
        default: false
        required: false
        type: boolean

permissions:
  contents: write
  actions: write

jobs:
  build:
    strategy:
      fail-fast: false
      matrix:
        CONFIG: [IPQ807X-AP8220-1G-WIFI-NO]
        SOURCE: [VIKINGYFY/immortalwrt]
    uses: ./.github/workflows/WRT-CORE-SELF.yml
    with:
      #编译配置
      WRT_CONFIG: ${{matrix.CONFIG}}
      #默认主题
      WRT_THEME: auto
      #默认主机名
      WRT_NAME: OWRT
      #默认WIFI名称
      WRT_SSID: OWRT
      #默认WIFI密码
      WRT_WORD: '12345678'
      #默认地址
      WRT_IP: 192.168.10.1
      #默认密码，仅作提示，修改无用
      WRT_PW: 无
      #源码链接
      WRT_REPO: https://github.com/${{matrix.SOURCE}}.git
      #源码分支
      WRT_BRANCH: ${{ inputs.FIRMWARE == '编译NSS固件' && 'main' || 'owrt' }}
      #源码名称
      WRT_SOURCE: ${{matrix.SOURCE}}
      #插件调整
      WRT_PACKAGE: ${{inputs.PACKAGE}}
      #仅输出配置文件
      WRT_TEST: ${{inputs.TEST || false}}
